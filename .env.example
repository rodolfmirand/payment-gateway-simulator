# Copy to .env and adjust. Variables already set in the environment (Docker, CI) take precedence over this file.
# All values below are the defaults.

# --- Server ---
PORT=4000
HOST=0.0.0.0
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Authentication ---
# Accepted secret keys (Basic Auth user, empty password), comma separated. Empty = any key starting with "sk_".
SIMULATOR_SECRET_KEYS=
# Accepted public keys (appId of POST /tokens), comma separated. Empty = any key starting with "pk_".
SIMULATOR_PUBLIC_KEYS=

# --- Account (sent in the "account" field of the webhooks) ---
SIMULATOR_ACCOUNT_ID=acc_Sim0000000000001
SIMULATOR_ACCOUNT_NAME=Pagar.me Simulator

# --- Asynchronous transitions (Pix paid, processing -> paid, ...) ---
SIMULATOR_ASYNC_DELAY_MS=5000

# --- Webhooks ---
# Endpoints that receive the webhooks, comma separated. Basic auth goes in the URL:
#   SIMULATOR_WEBHOOK_URLS=http://user:password@my-app:3000/webhooks/pagarme
SIMULATOR_WEBHOOK_URLS=
# Events sent to the endpoints above, comma separated (e.g. order.paid,charge.paid). Empty = all events.
SIMULATOR_WEBHOOK_EVENTS=
# Attempts per webhook (first delivery included), interval between retries and timeout of each attempt.
SIMULATOR_WEBHOOK_MAX_ATTEMPTS=3
SIMULATOR_WEBHOOK_RETRY_DELAY_MS=5000
SIMULATOR_WEBHOOK_TIMEOUT_MS=5000
